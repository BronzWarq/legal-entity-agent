# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=

# Обязательная привязка Главного администратора к числовому Telegram user_id.
# Username @Sholomon используется только как отображаемое имя и не является
# самостоятельным фактором авторизации.
MAIN_ADMIN_USER_ID=

# Необязательно: прокси для Telegram Bot API.
# Поддерживаются HTTPS/HTTP и SOCKS5: https://user:password@host:port
# или socks5://user:password@host:port. Не публикуйте это значение.
TELEGRAM_PROXY=

# Локальная база прав по чатам.
ACCESS_DB_PATH=data/access.sqlite3

# Официальный сервис ФНС. Значение можно переопределить для тестового стенда.
FNS_BASE_URL=https://egrul.nalog.ru/

# Ограничение ожидания ответа от ФНС, секунды.
FNS_TIMEOUT_SECONDS=20

# Необязательный официальный локальный слепок ЕГРЮЛ/ЕГРИП на VPS.
# Основной запрос остаётся направленным в ФНС; слепок используется только как резерв.
FNS_LOCAL_DB_ENABLED=false
FNS_LOCAL_DB_PATH=data/mcp_egrul_data.sqlite

# Необязательная расширенная проверка через atomno-mcp-fns-check.
# Установка: pip install -e ".[deep-check]".
# Включается только явно; по умолчанию отключена.
MCP_FNS_CHECK_ENABLED=false
MCP_FNS_CHECK_EXTENDED_RISKS=true
MCP_FNS_CHECK_LAWSUITS_THRESHOLD_RUB=1000000
# Необязательно: путь к загруженным локальным реестрам ФНС upstream.
MCP_FNS_REGISTRIES_DB=

# Журнал обратной связи для контролируемого обучения.
LEARNING_DB_PATH=data/learning.sqlite3

# По умолчанию исходные ИНН/ОГРН и тексты ответов не сохраняются.
LEARNING_STORE_RAW_REQUESTS=false

# Стабильная случайная внутренняя соль для хеширования user_id и идентификаторов.
# Бот не запускается, если значение не задано.
LEARNING_HASH_SALT=

# Путь выгрузки одобренных примеров администраторами.
LEARNING_EXPORT_PATH=data/learning.jsonl

# Необязательная очистка журнала при запуске, в днях. Пусто — без автоочистки.
LEARNING_RETENTION_DAYS=

# База сохранённых результатов проверок для команды /history.
HISTORY_DB_PATH=data/history.sqlite3

# Реестр лицензий и список компаний для мониторинга.
LICENSE_DB_PATH=data/licenses.sqlite3
WATCH_DB_PATH=data/watchlist.sqlite3
AUDIT_DB_PATH=data/audit.sqlite3
NOTIFICATION_DB_PATH=data/notifications.sqlite3
# Интервал фоновой проверки мониторинга, секунды (86400 = раз в сутки).
MONITOR_INTERVAL_SECONDS=86400
MONITOR_CONCURRENCY=2
LICENSE_ALERT_DAYS=30
# URL опубликованного Telegram Mini App; пусто — команда /app отключена.
MINI_APP_URL=
# Публичный HTTPS URL API Mini App для inline-кнопок в группах.
# Например: https://bot.example.ru/mini-app-api
MINI_APP_API_URL=
MINI_APP_API_HOST=127.0.0.1
MINI_APP_API_PORT=8081
# Origin GitHub Pages; по умолчанию берётся из MINI_APP_URL.
MINI_APP_ALLOWED_ORIGIN=https://bronzwarq.github.io
# Защищённый launch-контекст Mini App и лимиты API.
MINI_APP_CONTEXT_TTL_SECONDS=900
MINI_APP_API_MAX_BODY_BYTES=32768
MINI_APP_RATE_LIMIT_PER_MINUTE=30
MINI_APP_EXPENSIVE_RATE_LIMIT_PER_MINUTE=8
MINI_APP_RATE_LIMIT_WINDOW_SECONDS=60
MINI_APP_MAX_CONCURRENT_REQUESTS=8
# Максимальный возраст подписанных Telegram initData. Жёсткий предел нельзя
# превысить настройкой в .env.
MINI_APP_INIT_DATA_MAX_AGE_SECONDS=600
MINI_APP_INIT_DATA_HARD_MAX_AGE_SECONDS=900
MINI_APP_INIT_DATA_CLOCK_SKEW_SECONDS=60

# Email-уведомления о появлении отметки ФНС о недостоверности.
# Получатель вводится пользователем в Mini App и не задаётся по умолчанию.
# Пароль SMTP храните только в .env на сервере и не публикуйте в GitHub.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# Ограничения размера массового запуска. Проверки выполняются последовательно.
CHECK_ALL_CONCURRENCY=3
BULK_CONCURRENCY=3
BULK_MAX_ROWS=500
# Повторы временных сетевых ошибок ФНС.
BATCH_RETRY_ATTEMPTS=2
BATCH_RETRY_DELAY_SECONDS=3

# Необязательный разговорный skill через OpenAI API.
# Это API-ключ платформы, а не пароль или cookies от ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
CHAT_HISTORY_TURNS=8

# Реакции бота на сообщения разрешённых пользователей в текущем чате.
# REACTION_EMOJIS=all включает весь стандартный набор Telegram-реакций.
# Для нескольких реакций укажите их через запятую.
# REACTION_MODE=single оставляет первую, random выбирает случайную.
# В группе у бота должно быть право реагировать на сообщения.
REACTIONS_ENABLED=true
REACTION_EMOJIS=👍
REACTION_MODE=single
# Необязательно: ID custom emoji, разрешённого настройками чата.
REACTION_CUSTOM_EMOJI_ID=
