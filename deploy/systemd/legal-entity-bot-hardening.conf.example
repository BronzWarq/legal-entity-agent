# Установить как drop-in:
# /etc/systemd/system/legal-entity-bot.service.d/hardening.conf
#
# После установки проверить systemd-analyze security legal-entity-bot и
# journalctl -u legal-entity-bot. Не применять без проверки путей записи.

[Service]
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/legal-entity-agent/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
